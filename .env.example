# ── Obrigatórios ─────────────────────────────────────────────
CLICKUP_API_TOKEN=pk_xxx            # token pessoal, vai PURO no header (sem Bearer) — usado só pra anexar o resultado
PEXELS_API_KEY=xxx                  # busca de fotos (substitui o pool do Drive)

# ── Recomendados ─────────────────────────────────────────────
OPENAI_API_KEY=xxx                  # queries de busca + curadoria por visão da foto; sem a chave, cai em "{cargo} portrait" + só filtro de rosto (fotos piores)
GENERATE_TOKEN=xxx                  # protege POST /generate (quem chama envia Bearer); sem ele, aberto
# Discord p/ notificar falhas — bot API. Sem os dois, falha só vai pro log.
# DISCORD_BOT_TOKEN: token do bot (Developer Portal → Bot → Reset Token); o bot
#   precisa estar no servidor e ter permissão de enviar mensagem no canal.
# DISCORD_CHANNEL_ID: ID do canal (botão direito no canal → Copiar ID do canal).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_MENTION=                    # opcional: "@everyone" ou "<@&ID_DO_CARGO>" colado no início do alerta
# nome do workflow que aparece no alerta de erro (tem default no código)
DISCORD_PROJETO=LAB-706 | Criativos

# ── Opcionais (têm fallback) ─────────────────────────────────
FOTO_PROVIDER=pexels                # "pexels" (default) ou "unsplash" (teste — ver app/unsplash.py)
UNSPLASH_ACCESS_KEY=                # só necessário se FOTO_PROVIDER=unsplash
CRIATIVOS_POR_VAGA=3               # nº de artes por vaga (cada uma = 1 pipeline independente)
FOTOS_EXCLUIR_ULTIMAS_N=5
RENDER_SCALE=1                      # 1 → 1080×1350; 2 → 2160×2700
STATE_DB=./state.db                 # aponte p/ volume persistente no deploy
PORT=3001
